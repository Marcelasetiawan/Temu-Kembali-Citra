outputs/runs/**/best.pt
outputs/runs/**/gallery.npz
!outputs/runs/s2_augment__densenet121__seed7/best.pt
!outputs/runs/s2_augment__densenet121__seed7/gallery.npz

# Log proses
*.log

# Dokumen tugas (memuat nama dan NIM anggota) dan naskah artikel pihak lain
