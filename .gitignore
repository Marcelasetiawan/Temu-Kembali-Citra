# Lingkungan Python dan cache
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Skrip pembuat dokumen (bukan kode penelitian)
tools/

# Dataset asli (±1,2 GB) dan cache citra hasil pra-proses (±470 MB);
# unduh dataset dari Kaggle/Mendeley lalu jalankan src/prepare_data.py
data pneumonia/
data/cache/

# Bobot model dan galeri embedding semua percobaan (±775 MB);
